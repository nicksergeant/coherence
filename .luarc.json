{
  "$schema": "https://raw.githubusercontent.com/sumneko/vscode-lua/master/setting/schema.json",
  "runtime": {
    "version": "LuaJIT",
    "path": [
      "?.lua",
      "?/init.lua"
    ]
  },
  "workspace": {
    "library": [
      "${3rd}/love2d/library"
    ],
    "checkThirdParty": false
  },
  "diagnostics": {
    "globals": [
      "love",
      "DEBUG"
    ]
  },
  "format": {
    "enable": false
  }
}